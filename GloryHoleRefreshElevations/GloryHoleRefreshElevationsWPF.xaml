<Window x:Class="GloryHoleRefreshElevations.GloryHoleRefreshElevationsWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:GloryHoleRefreshElevations"
        mc:Ignorable="d"
        Title="Обновить отметки"
        SizeToContent="Height"
        Width="430"
        MinHeight="430"
        MinWidth="430"
        MaxWidth="430"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Icon="Resources/citrus.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource BaseFont}"
        FontSize="{DynamicResource FontSizeBase}"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource PageBgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Language="ru-RU">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CitrusTheme/CitrusTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox x:Name="groupBox_RefreshElevationsOption"
                  Grid.Row="0"
                  Header="Выберите опцию:"
                  Margin="0,0,0,8">
            <Grid Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="rbt_AllProject"
                             Grid.Column="0"
                             Content="Во всем проекте"
                             Height="32"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Padding="5,0,0,0"
                             IsChecked="True"
                             Checked="RefreshScope_Checked"/>

                <RadioButton x:Name="rbt_SelectedItems"
                             Grid.Column="1"
                             Content="В выбранных элементах"
                             Height="32"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Padding="5,0,0,0"
                             Checked="RefreshScope_Checked"/>
            </Grid>
        </GroupBox>

        <GroupBox x:Name="groupBox_RoundHolesPosition"
                  Grid.Row="1"
                  Header="Округлять отметки отверстий в стенах:"
                  Margin="0,0,0,8">
            <Grid Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="radioButton_RoundHolesPositionYes"
                             Grid.Column="0"
                             Content="Да"
                             Width="45"
                             Height="32"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             IsChecked="True"
                             Checked="radioButton_RoundHolesPosition_Checked"/>

                <RadioButton x:Name="radioButton_RoundHolesPositionNo"
                             Grid.Column="1"
                             Content="Нет"
                             Width="45"
                             Height="32"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Checked="radioButton_RoundHolesPosition_Checked"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label x:Name="label_RoundHolePosition"
                   Grid.Column="0"
                   Content="Округлять отметки отверстий до:"
                   Height="32"
                   VerticalContentAlignment="Center"
                   IsEnabled="False"/>

            <TextBox x:Name="textBox_RoundHolePositionIncrement"
                     Grid.Column="1"
                     Text="5"
                     Width="50"
                     Height="32"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"
                     TextWrapping="Wrap"
                     SpellCheck.IsEnabled="True"
                     IsEnabled="False"/>

            <Label x:Name="label_RoundHolePositionMM"
                   Grid.Column="2"
                   Content="мм"
                   Height="32"
                   VerticalContentAlignment="Center"
                   IsEnabled="False"/>
        </Grid>

        <GroupBox x:Name="groupBox_RoundHolesLocation"
                  Grid.Row="3"
                  Header="Округлять положение отверстий:"
                  Margin="0,0,0,8">
            <Grid Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="radioButton_RoundHolesLocationYes"
                             Grid.Column="0"
                             Content="Да"
                             Width="45"
                             Height="32"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             IsChecked="False"
                             Checked="radioButton_RoundHolesLocation_Checked"/>

                <RadioButton x:Name="radioButton_RoundHolesLocationNo"
                             Grid.Column="1"
                             Content="Нет"
                             Width="45"
                             Height="32"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             IsChecked="True"
                             Checked="radioButton_RoundHolesLocation_Checked"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label x:Name="label_RoundHoleLocation"
                   Grid.Column="0"
                   Content="Округлять координаты отверстий до:"
                   Height="32"
                   VerticalContentAlignment="Center"
                   IsEnabled="False"/>

            <TextBox x:Name="textBox_RoundHoleLocationIncrement"
                     Grid.Column="1"
                     Text="5"
                     Width="50"
                     Height="32"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"
                     TextWrapping="Wrap"
                     SpellCheck.IsEnabled="True"
                     IsEnabled="False"/>

            <Label x:Name="label_RoundHoleLocationMM"
                   Grid.Column="2"
                   Content="мм"
                   Height="32"
                   VerticalContentAlignment="Center"
                   IsEnabled="False"/>
        </Grid>

        <GroupBox Grid.Row="5" Header="Привязка болванок:" Margin="0,0,0,8">
            <StackPanel Margin="8,2,8,8">
                <CheckBox x:Name="checkBox_RebindToLevels"
                          Content="Перепривязать к уровням"
                          FontWeight="SemiBold" MinHeight="28"
                          IsChecked="False"
                          Checked="RebindToLevels_Changed"
                          Unchecked="RebindToLevels_Changed"/>
                <WrapPanel Margin="24,4,0,0">
                    <RadioButton x:Name="rbt_RebindAutomatically"
                                 Content="Автоматически" GroupName="RebindMode"
                                 MinHeight="28" Margin="0,0,16,0"
                                 IsChecked="True" IsEnabled="False"
                                 Checked="RebindMode_Checked"/>
                    <RadioButton x:Name="rbt_RebindSelectedLevel"
                                 Content="К выбранному уровню" GroupName="RebindMode"
                                 MinHeight="28" IsEnabled="False"
                                 Checked="RebindMode_Checked"/>
                </WrapPanel>
                <Grid x:Name="panel_RebindLevel" Visibility="Collapsed" Margin="24,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Уровень:" Target="{Binding ElementName=comboBox_RebindLevel}"
                           VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="comboBox_RebindLevel" Grid.Column="1"
                              MinHeight="32" DisplayMemberPath="DisplayName"
                              SelectedValuePath="UniqueId"
                              AutomationProperties.Name="Уровень для перепривязки"/>
                </Grid>
                <TextBlock x:Name="textBlock_RebindWarning" Visibility="Collapsed"
                           Text="После перепривязки проверьте привязку к уровням."
                           TextWrapping="Wrap" Margin="24,8,0,0"
                           Foreground="{DynamicResource SubtleTextBrush}"/>
            </StackPanel>
        </GroupBox>

        <CheckBox x:Name="checkBox_UpdaterOn"
                  Grid.Row="6"
                  Content="Обновлять отметки автоматически"
                  Height="32"
                  VerticalAlignment="Top"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,10">
            <CheckBox.ToolTip>
                <ToolTip MaxWidth="220">
                    <StackPanel>
                        <TextBlock Text="Автообновление" FontWeight="Bold"/>
                        <TextBlock Text="При активированной опции плагин будет обновлять значения параметров автоматически в фоновом режиме."
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ToolTip>
            </CheckBox.ToolTip>
        </CheckBox>
        </Grid>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btn_Ok"
                    Grid.Column="1"
                    Content="Ок"
                    Width="100"
                    Height="32"
                    Padding="10,0,10,0"
                    IsDefault="True"
                    Click="btn_Ok_Click"/>

            <Button x:Name="btn_Cancel"
                    Grid.Column="3"
                    Content="Отмена"
                    Width="100"
                    Height="32"
                    Padding="10,0,10,0"
                    IsCancel="True"
                    Click="btn_Cancel_Click"
                    Style="{StaticResource ButtonOutline}"/>
        </Grid>
    </Grid>
</Window>
